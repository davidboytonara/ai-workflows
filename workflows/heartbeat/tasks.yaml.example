tasks:
  - name: memory-distill
    cron: "0 */6 * * *"
    cron_tz: "UTC"
    catchup: one
    precondition: "${HOME}/.agents/.venv/bin/python ${HOME}/.agents/workflows/memory-workflow/check_pending.py"
    type: pi_workflow
    workflow: ${HOME}/.agents/workflows/memory-workflow/distill-memory.md
    prompt: |
      Run the attached distill-memory workflow now. Heartbeat detected new or
      changed chat session history (memory-workflow extractor sources have
      diverged from state/memory-distill/extract_session_history.json). Do not
      delete or clean up files. Report a concise summary of what was distilled.

      If you cannot proceed without user input, write a clarify file at
      `~/.agents/state/clarify/memory-distill-<runid>.md` with your specific
      question under the `## Task question` section, then exit with code 42.
      The daemon will pause this task until the user fills in `## User reply:`,
      then will resume it with the user's answer appended to this prompt.

  # A `shell` task runs a command directly — no LLM, no workflow file, no prompt.
  # Uncomment and adapt. Set cron_tz to your own IANA zone (e.g. "Europe/Berlin")
  # if you want local-time scheduling; it defaults to UTC above.
  #
  # - name: disk-usage-report
  #   cron: "0 9 * * 1"
  #   cron_tz: "UTC"
  #   catchup: none
  #   type: shell
  #   timeout_seconds: 120
  #   command: ["/bin/sh", "-c", "df -h /"]
