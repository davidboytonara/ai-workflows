[Unit]
Description=Casper heartbeat memory distillation daemon
Documentation=file:%h/.agents/workflows/heartbeat/heartbeat_daemon.py
StartLimitIntervalSec=5min
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/.agents
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.agents/.env
EnvironmentFile=-%h/.agents/.config
ExecStart=%h/.agents/.venv/bin/python %h/.agents/workflows/heartbeat/heartbeat_daemon.py --pi-binary %h/.local/bin/pi
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=default.target
