# ─────────────────────────────────────────────────────────────────────────────
# Secrets & credentials — NEVER commit. Patterns are unanchored on purpose so
# they match at any depth.
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
*.env
*.env.bak*
!*.env.example

# Centralized non-secret config. The filled copy lives at ~/.agents/.config and
# holds workspace IDs; only the template is committed.
.config
!.config.example

# Local working copy of the workflow tree. The shipped tree is workflows/ —
# never commit a second, drifting copy of it.
.agents/
credentials/
**/credentials/**
client_secret*.json
credentials.json
token.json
token.*.json
**/storage_state.json
ff_state.json
*service-account*.json
*_credentials.json
*.pem
*.p12
*.pfx
*.key
id_rsa*
id_ed25519*
.netrc
.npmrc

# Browser session state & persistent profiles.
# Ignore the *contents* rather than the directory, so the .gitkeep still ships
# and a fresh clone gets the directory the workflows expect to write into.
**/.auth/*
!**/.auth/.gitkeep
.pw-profile/
**/.pw-profile/**
**/Local State
**/Cookies*
**/Login Data*
**/Local Storage/
**/Session Storage/
**/IndexedDB/
**/Service Worker/

# Local databases / browser stores
*.sqlite
*.sqlite3
*.db
*.db-journal
*.duckdb
*.leveldb
*.ldb

# ─────────────────────────────────────────────────────────────────────────────
# Vendored binaries & environments — reinstallable, and in the browsers' case
# NOT redistributable (Google Chrome / Widevine CDM are proprietary).
# ─────────────────────────────────────────────────────────────────────────────
.browsers/
**/.browsers/**
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ─────────────────────────────────────────────────────────────────────────────
# Runtime output & operational history — machine-local, and a common channel
# for leaking absolute home paths, prod infra and third-party data.
# ─────────────────────────────────────────────────────────────────────────────
logs/
*.log
artifacts/
cache-dir/
handovers/
evidence/
objstore-test/
pi-sessions/
**/pi-sessions/**
secrets/
debug/

# Runtime state dirs — ship the directory, never its contents.
# Unanchored twins are deliberate: the workflows/ rules alone miss any other
# checkout location (e.g. a local .agents/workflows/ working copy).
workflows/kernel-browser/state/*
!workflows/kernel-browser/state/.gitkeep
**/state/last_session.json
workflows/memory-workflow/sources/*/*
!workflows/memory-workflow/sources/*/.gitkeep
**/memory-workflow/sources/*/*
!**/memory-workflow/sources/*/.gitkeep

# Live heartbeat config (ship tasks.yaml.example instead)
workflows/heartbeat/tasks.yaml
**/heartbeat/tasks.yaml

# Archives
*.tar.gz
*.tgz
*.zip

# codebase-memory-mcp local graph store — regenerable, environment-specific,
# goes stale the moment someone else's commit lands. Regenerate per clone
# instead of committing it (see codebase-memory-workflow/codebase-memory-workflow.md).
.codebase-memory/

# Local editor / agent config
.claude/settings.local.json
.DS_Store
