# ─────────────────────────────────────────────────────────────────────────────
# SECRETS — every credential any workflow needs, in one file.
#
#   cp .env.example ~/.agents/.env && chmod 600 ~/.agents/.env
#
# Then fill in only what the workflows you actually use need. Nothing here is
# required up front: a workflow that needs a value it cannot find fails with
# the variable name, so you can add it then.
#
# NEVER commit the filled copy. `.gitignore` blocks it; do not weaken that.
#
# FORMAT — strict KEY=VALUE, one per line. Comments only on their own line.
# No `export `, no $VAR interpolation, no inline comment after a value, no
# multi-line values. The heartbeat systemd unit reads this file directly and
# understands only that subset.
#
# PRECEDENCE — a real environment variable always wins over this file, which
# in turn wins over ~/.agents/.config. Export a var to override for one run.
# ─────────────────────────────────────────────────────────────────────────────


# ── clickup-workflow ─────────────────────────────────────────────────────────
# Personal API token. ClickUp > avatar > Settings > Apps > API Token.
# Begins with "pk_". The non-secret workspace IDs go in .config, not here.
CLICKUP_API_TOKEN=


# ── kernel-browser ───────────────────────────────────────────────────────────
# API key for the Kernel hosted browser. Dashboard > API Keys.
KERNEL_API_KEY=


# ── heartbeat ────────────────────────────────────────────────────────────────
# Slack Incoming Webhook the heartbeat daemon posts to.
# https://api.slack.com/messaging/webhooks
# Leave blank to disable Slack notifications entirely.
CASPER_SLACK_WEBHOOK_URL=


# ── gsheet / gdocs / gslides / gmail workflows ───────────────────────────────
# Directory holding your Google OAuth client secret and its token cache.
#
# These two cannot be environment variables: the Google client library needs a
# real file and rewrites the token on every refresh. This variable is how they
# get centralized — one directory, shared by all four workflows.
#
# Set up once:
#   mkdir -p ~/.agents/credentials && chmod 700 ~/.agents/credentials
# then download an OAuth client ID of type "Desktop app" from
# Google Cloud Console > APIs & Services > Credentials, and save it as
#   ~/.agents/credentials/client_secret.json
# The matching token.json is written there on your first successful login.
#
# Defaults to ~/.agents/credentials when left blank.
GOOGLE_CREDENTIALS_DIR=
